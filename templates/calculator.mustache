{{!
    This is the mustache for the time block simple calculator.
    @template block_simple_calculator/simple_calculator
    This template renders the entire block content.
}}
<style>

 a[class^="data-block-calculator-"] {
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    &:active {
        filter: brightness(80%);
        transition: 150ms;
        
        &:after {
            filter: brightness(100%);
        }
    }
 }

 .data-block-calculator-number, .data-block-calculator-operation, .data-block-calculator-delete {
    color: black!important;
 }

 .data-block-calculator-all-clear, .data-block-calculator-equals {
    color: white!important;
 }


 div[id^="data-block-calculator-"] {
    font-size: 1.2rem;
 }

.data-block-calculator-output {
    min-height: 175px;
    word-wrap: break-word;
    word-break: break-all;
    line-height: 1.5;
    -webkit-box-shadow: inset 0px 1px 10px 5px rgba(0,0,0,0.42); 
    box-shadow: inset 0px 1px 10px 5px rgba(0,0,0,0.42);
}

.fa-circle-xmark {
    font-size: 1.1rem;
}

.calculator-rounded-top {
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

.calculator-rounded-bottom-left {
    border-bottom-left-radius: 16px;
}

.calculator-rounded-bottom-right {
    border-bottom-right-radius: 16px;
}
.calculator-rounded {
    border-radius: 16px;
}
.calculator-bg-transparent {
    background-color: transparent;
}

</style>
<div class="calculator-rounded calculator-bg-transparent border" id="data-block-calculator" tabIndex="-1">
    <div class="bg-secondary p-3 border-bottom calculator-rounded-top border-light d-flex justify-content-end" id="data-block-drag-header">
        <a class="button-block-calculator-popout d-flex link-primary" role="button">
            <div id="button-block-calculator-popout-text">{{#str}}calculator_popout, block_simple_calculator{{/str}}</div>
            <i class="fa-solid fa-arrow-up-right-from-square ml-1 mt-1" id="button-block-calculator-popout-icon"></i>
        </a>
    </div>
    <div class="data-block-calculator-output bg-dark 
        p-5 d-flex align-items-end justify-content-around flex-column border-bottom border-light">
        <div id="data-block-calculator-previous-operand" class="text-secondary font-weight-bold m-0"></div>
        <div id="data-block-calculator-current-operand" class="text-white font-weight-bold"></div>
    </div>
    <div class="row p-0 m-0 calculator-bg-transparent">
        <a class="data-block-calculator-all-clear col bg-danger font-weight-bold border p-3" id="data-block-AC">AC</a>
        <a class="data-block-calculator-delete col bg-secondary font-weight-bold border p-3" id="data-block-DEL">DEL</a>
    </div>
    <div class="row p-0 m-0 calculator-bg-transparent">
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-parenthesis-open">&#40;</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-parenthesis-close">&#41;</a>
        <a class="data-block-calculator-operation col-3 bg-secondary font-weight-bold border p-3" id="data-block-divide">÷</a>
    </div>
    <div class="row p-0 m-0 calculator-bg-transparent">
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-1">1</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-2">2</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-3">3</a>
        <a class="data-block-calculator-operation col bg-secondary font-weight-bold border p-3" id="data-block-multiply">*</a>
    </div>
    <div class="row p-0 m-0 calculator-bg-transparent">
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-4">4</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-5">5</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-6">6</a>
        <a class="data-block-calculator-operation col bg-secondary font-weight-bold border p-3" id="data-block-plus">+</a>
    </div>
    <div class="row p-0 m-0 calculator-bg-transparent">
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-7">7</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-8">8</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-9">9</a>
        <a class="data-block-calculator-operation col bg-secondary font-weight-bold border p-3" id="data-block-minus">-</a>
    </div>
    <div class="row p-0 m-0 calculator-bg-transparent">
         <a class="data-block-calculator-operation col bg-light font-weight-bold border calculator-rounded-bottom-left p-3" id="data-block-negative">+/-</a>   
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-0">0</a>
        <a class="data-block-calculator-number col bg-light font-weight-bold border p-3" id="data-block-decimal">.</a>
        <a class="data-block-calculator-equals col bg-primary font-weight-bold border calculator-rounded-bottom-right p-3" id="data-block-equals">=</a>
    </div>
</div>
<div class="alert alert-info mt-2 mb-2" role="alert">{{#str}}calculator_popout_description, block_simple_calculator{{/str}}</div>
